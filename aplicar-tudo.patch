diff --git a/lib/expirar-contatos.ts b/lib/expirar-contatos.ts
new file mode 100644
index 0000000..ba1f8c5
--- /dev/null
+++ b/lib/expirar-contatos.ts
@@ -0,0 +1,44 @@
+import type { SupabaseClient } from '@supabase/supabase-js'
+
+/** Após este tempo em "Contato realizado" sem avanço → Sem interesse. */
+export const HORAS_SEM_RESPOSTA = 48
+export const MOTIVO_NAO_RESPONDEU = 'Não respondeu'
+
+type Resultado = { movidos: number; erro: string | null }
+
+/**
+ * Move para "Sem interesse" (motivo "Não respondeu") os leads em
+ * "Contato realizado" há mais de HORAS_SEM_RESPOSTA horas.
+ * Critério: status = contato_realizado e (ultimo_contato ?? created_at) < agora − 48h.
+ *
+ * Aceita qualquer cliente Supabase (browser com RLS ou admin com service_role).
+ */
+export async function expirarContatosSemRespostaCom(db: SupabaseClient): Promise<Resultado> {
+  const limite = new Date(Date.now() - HORAS_SEM_RESPOSTA * 60 * 60 * 1000).toISOString()
+  const { data, error } = await db
+    .from('leads')
+    .select('id, ultimo_contato, created_at')
+    .eq('status', 'contato_realizado')
+  if (error) return { movidos: 0, erro: error.message }
+
+  const ids = (data || [])
+    .filter(l => (l.ultimo_contato || l.created_at) < limite)
+    .map(l => l.id as string)
+  if (ids.length === 0) return { movidos: 0, erro: null }
+
+  let movidos = 0
+  for (let i = 0; i < ids.length; i += 100) {
+    const lote = ids.slice(i, i + 100)
+    const { error: errUp } = await db
+      .from('leads')
+      .update({
+        status: 'sem_interesse',
+        motivo_perda: MOTIVO_NAO_RESPONDEU,
+        proximo_contato: null,
+      })
+      .in('id', lote)
+    if (errUp) return { movidos, erro: errUp.message }
+    movidos += lote.length
+  }
+  return { movidos, erro: null }
+}
diff --git a/lib/leads-acoes.ts b/lib/leads-acoes.ts
index a4f7a12..7abcb56 100644
--- a/lib/leads-acoes.ts
+++ b/lib/leads-acoes.ts
@@ -1,10 +1,23 @@
 import { supabase } from './supabase/client'
 import type { Status } from './types'
+import { expirarContatosSemRespostaCom, HORAS_SEM_RESPOSTA, MOTIVO_NAO_RESPONDEU } from './expirar-contatos'
+
+export { HORAS_SEM_RESPOSTA, MOTIVO_NAO_RESPONDEU }
 
 // Muda o status de um ou vários leads. "Sem interesse" guarda o motivo; fechado/perdido limpa o follow-up.
+// Ao entrar em "Contato realizado", marca ultimo_contato (relógio das 48h).
 export async function atualizarStatus(ids: string[], status: Status, motivo?: string | null) {
   const campos: Record<string, unknown> = { status, motivo_perda: status === 'sem_interesse' ? (motivo ?? null) : null }
   if (status === 'convertido' || status === 'sem_interesse') campos.proximo_contato = null
+  if (status === 'contato_realizado') campos.ultimo_contato = new Date().toISOString()
   const { error } = await supabase().from('leads').update(campos).in('id', ids)
   return error?.message ?? null
 }
+
+/**
+ * Versão do navegador (respeita RLS — só leads do usuário logado).
+ * O cron do servidor usa a mesma lógica com service_role em /api/cron/expirar-contatos.
+ */
+export async function expirarContatosSemResposta() {
+  return expirarContatosSemRespostaCom(supabase())
+}
diff --git a/lib/supabase/admin.ts b/lib/supabase/admin.ts
new file mode 100644
index 0000000..a354e54
--- /dev/null
+++ b/lib/supabase/admin.ts
@@ -0,0 +1,17 @@
+import { createClient, type SupabaseClient } from '@supabase/supabase-js'
+
+/**
+ * Cliente com service_role — só no servidor (API/cron).
+ * Ignora RLS e enxerga leads de todos os usuários.
+ * NUNCA importe este módulo em componentes 'use client'.
+ */
+export function supabaseAdmin(): SupabaseClient {
+  const url = process.env.NEXT_PUBLIC_SUPABASE_URL
+  const key = process.env.SUPABASE_SERVICE_ROLE_KEY
+  if (!url || !key) {
+    throw new Error('Faltam NEXT_PUBLIC_SUPABASE_URL ou SUPABASE_SERVICE_ROLE_KEY no ambiente do servidor')
+  }
+  return createClient(url, key, {
+    auth: { persistSession: false, autoRefreshToken: false },
+  })
+}
